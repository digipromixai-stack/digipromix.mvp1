VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_CRAWLER_URL=https://your-render-service.onrender.com/api/trigger

# Required for AI campaign generator (Edge Function secret — set via: supabase secrets set OPENAI_API_KEY=sk-...)
# OPENAI_API_KEY=sk-...

# Meta (Facebook/Instagram) Ads Integration
# Get from: https://developers.facebook.com/apps → your app → Settings → Basic
# Optional: defaults to the production DigiPromix Meta App when not set.
# Override only for staging / local-dev with a different Meta App.
VITE_META_APP_ID=1502467894875434

# Edge Function / Vault secrets (already stored in Supabase Vault — no .env needed):
#   meta_app_id            (16-digit)
#   meta_app_secret        (32-char hex)
#   meta_business_id       (16-digit)
#   meta_system_user_token (long-lived user/system-user token, EAA...)
